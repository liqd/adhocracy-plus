{
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * *"
  ],
  "packageRules": [
    {
      "groupName": "eslint packages",
      "matchPackageNames": [
        "/^eslint/"
      ]
    },
    {
      "matchPackageNames": [
        "Django"
      ],
      "allowedVersions": "/(^3\\.2\\.[0-9]+$)|(^4\\.2\\.[0-9]+$)|(^5\\.2\\.[0-9]+$)/"
    },
    {
      "matchPackageNames": [
        "wagtail"
      ],
      "allowedVersions": "7.4.x"
    },
    {
      "matchPackageNames": [
        "bootstrap"
      ],
      "allowedVersions": "5.2.3"
    },
    {
      "matchPackageNames": [
        "maplibre-gl"
      ],
      "allowedVersions": "<6"
    },
    {
      "matchDepTypes": [
        "dependencies",
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDepTypes": [
        "devDependencies",
        "dependency-groups"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "digest": {
    "enabled": false
  },
  "labels": [
    "renovate"
  ]
}
